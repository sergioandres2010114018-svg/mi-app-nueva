name: Generar APK

on:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  apk:
    name: Compilar APK
    runs-on: ubuntu-24.04
    timeout-minutes: 40

    steps:
      - name: Descargar el código
        uses: actions/checkout@v7

      - name: Instalar Node 22
        uses: actions/setup-node@v7
        with:
          node-version: 22

      - name: Instalar Java 21
        uses: actions/setup-java@v6
        with:
          distribution: temurin
          java-version: '21'
